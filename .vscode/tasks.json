{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "inputs": [
        {
            "id": "silverblue-point-release",
            "type": "promptString",
            "description": "Enter a point release (.20261016.0)",
        }
    ],
    "tasks": [
        {
            "label": "Build image",
            "type": "shell",
            "command": "./scripts/build-image.sh --no-rechunk",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build image (no-cache)",
            "type": "shell",
            "command": "./scripts/build-image.sh --no-rechunk --no-cache",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build point release",
            "type": "shell",
            "command": "./scripts/build-image.sh --no-rechunk --point-release ${input:silverblue-point-release}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build and push to local registry",
            "type": "shell",
            "command": "./scripts/build-image.sh --no-rechunk --push",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run any-setup (from system)",
            "type": "shell",
            "command": "any-setup --pages-dir ./spec-files/redtide-setup/pages --configs-dir ./spec-files/redtide-setup/configs",
            "problemMatcher": []
        },
        {
            "label": "Run any-setup (from repo)",
            "type": "shell",
            "command": "../any-setup/target/debug/any-setup --pages-dir ./spec-files/redtide-setup/pages --configs-dir ./spec-files/redtide-setup/configs",
            "problemMatcher": []
        },
        {
            "label": "Run silverblue interactive",
            "type": "shell",
            "command": "podman run --rm -it quay.io/fedora/fedora-silverblue:latest bash",
            "problemMatcher": []
        },
        {
            "label": "Podman clean",
            "type": "shell",
            "command": "podman system prune -af --volumes && podman image prune -af --build-cache --external",
            "problemMatcher": []
        }
    ]
}