{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build image with podman",
            "type": "shell",
            "command": "podman build --pull -f ./Containerfile -t localhost:5000/redtide:latest .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build image with podman (no-cache)",
            "type": "shell",
            "command": "podman build --no-cache --pull -f ./Containerfile -t localhost:5000/redtide:latest .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Push latest image to local registry",
            "type": "shell",
            "command": "podman container start registry || podman container run -dt -p 0.0.0.0:5000:5000 --name registry docker.io/library/registry:2 && podman push --format=oci localhost:5000/redtide:latest",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build test with log file (no-cache)",
            "type": "shell",
            "command": "podman build --no-cache --pull -f ./Containerfile -t localhost:5000/redtide:latest . 2>&1 | tee build.log",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Podman clean",
            "type": "shell",
            "command": "podman system prune -af --volumes && podman image prune -af --build-cache --external",
            "problemMatcher": []
        }
    ]
}