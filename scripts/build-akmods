#!/bin/bash

set -e
set -o pipefail

kernel_version=$1
destination=$2

source "$(dirname "${BASH_SOURCE[0]}")/deps/repo.sh"

for package_config in "$PACKAGES_DIR"/*.yml; do
    echo_color "Checking for kmod packages in $package_config"

    mapfile -t repos < <(yq -o=json -I=0 '.[]' "$package_config")

    for repo_packages in "${repos[@]}"; do
        # repo_packages is a single JSON snippet
        repo=$(yq '.repo' <<<"$repo_packages")
        repo_file=$(yq '.repo_file' <<<"$repo_packages")
        disable_repo=$(yq '.disable_repo' <<<"$repo_packages")
        mapfile -t kmod_packages < <(yq -r '.kmods[].package' <<<"$repo_packages")
        mapfile -t kmod_names < <(yq -r '.kmods[].akmod' <<<"$repo_packages")

        if [ -n "${kmod_packages[*]}" ]; then
            echo_color "Installing kmod packages for $package_config: '$repo'"

            if [ "$repo" = "fedora" ]; then
                dnf -y install "${kmod_packages[@]}"

            elif [ ! -f "${REPOS_DIR}/${repo_file}" ]; then
                enable_repo "$repo_file" "$repo"
                dnf -y install "${kmod_packages[@]}"
                [ "$disable_repo" = "false" ] || disable_repo "$repo_file" "$repo"

            else
                enable_repo_extern "$repo_file" "$repo"
                dnf -y install "${kmod_packages[@]}"
                [ "$disable_repo" = "false" ] || disable_repo_extern "$repo_file" "$repo"
            fi

            echo_color "Killing potential akmod background builds from post scripts"

            echo "Akmods processes:"
            pgrep -l -x akmods || echo "Nothing found"
            echo_warning "Killing akmods builds"
            sudo pkill -x akmods || echo "Nothing found"
            echo "Akmods processes:"
            pgrep -l -x akmods || echo "Nothing found"
        fi

        for name in "${kmod_names[@]}"; do
            echo_color "Cleaning kmod build cache"
            sudo rm -rf /var/cache/akmods/*

            echo_color "Building kmod package $package_config: '$name'"

            akmods --force --kernel "$kernel_version" --kmod "$name"

            if ! test -n "$(find "/var/cache/akmods/" -name '*.rpm' -print -quit)"; then
                echo_error "Failed to build kmod $name"
                for log in /var/cache/akmods/*/*.log; do
                    echo_error -e "\n${log}:"
                    cat "$log"
                    echo ""
                done
                exit 1
            fi

            mkdir -p "${destination}/${name}"
            mv /var/cache/akmods/*/*.rpm "${destination}/${name}/"

            echo_color "Kmod destination list:"
            ls "${destination}/${name}/"

            echo_success "Successfully built kmod for $package_config: '$name'"
        done
    done

done
