#!/bin/bash

set -e
set -o pipefail

yml_file=$1
package_config="${PACKAGES_DIR}/${yml_file}"

source "$(dirname "${BASH_SOURCE[0]}")/deps/repo.sh"
source "$(dirname "${BASH_SOURCE[0]}")/deps/gnome-extensions.sh"
source "$(dirname "${BASH_SOURCE[0]}")/deps/dconf.sh"

if [ ! -f "$package_config" ]; then
	echo_error "Config file not found: $package_config"
	exit 1
fi

echo_color "Importing kmod signing key"
rpm --import "${KEYS_DIR}/RPM-GPG-KEY-local_kmod"

echo_color "\n==== Installing $yml_file ===="

config=$(envsubst <"$package_config")
mapfile -t repos < <(yq -o=j -I=0 '.[]' <<<"$config")

if [ ${#repos[@]} -eq 0 ]; then
	echo_error "Failed to parse package configuration or configuration is empty"
	exit 1
fi

for repo_packages in "${repos[@]}"; do
	# Support both String and Array type for repo names and files
	if [ "$(yq -r '.repo | tag' <<<"$repo_packages")" = "!!seq" ]; then
		mapfile -t repos < <(yq -r '.repo[]' <<<"$repo_packages")
	else
		mapfile -t repos < <(yq -r '.repo' <<<"$repo_packages")
	fi

	if [ "$(yq -r '.repo_file | tag' <<<"$repo_packages")" = "!!seq" ]; then
		mapfile -t repo_files < <(yq -r '.repo_file[]' <<<"$repo_packages")
	else
		# shellcheck disable=SC2034
		mapfile -t repo_files < <(yq -r '.repo_file' <<<"$repo_packages")
	fi

	disable_repo=$(yq '.disable_repo' <<<"$repo_packages")
	pre_install_command=$(yq '.pre_install_command' <<<"$repo_packages")
	post_install_command=$(yq '.post_install_command' <<<"$repo_packages")
	mapfile -t packages_install < <(yq '.install[]' <<<"$repo_packages")
	mapfile -t packages_remove < <(yq '.remove[]' <<<"$repo_packages")
	mapfile -t packages_extensions < <(yq '.extensions[]' <<<"$repo_packages")
	mapfile -t kmod_names < <(yq -r '.kmods[].akmod' <<<"$repo_packages")
	mapfile -t dconf_configs < <(yq '.dconf[]' <<<"$repo_packages")

	enable_repos repo_files repos

	# Kmods
	if [ -n "${kmod_names[*]}" ]; then
		echo_color "Installing kmods for $yml_file: '${repos[*]}'"

		for name in "${kmod_names[@]}"; do
			for rpm_package in "${KMODS_RPM_DIR}"/"${name}"/*.rpm; do
				kmod_packages_paths+=("$rpm_package")
			done
		done

		if [ -z "${kmod_packages_paths[*]}" ]; then
			echo_error "Failed to get kmod packages in ${KMODS_RPM_DIR}/${name}/"
			exit 1
		fi

		rpm-ostree install "${kmod_packages_paths[@]}"
	fi

	# Extensions
	if [ -n "${packages_extensions[*]}" ]; then
		echo_color "Installing extensions for $yml_file: '${repos[*]}'"

		for extension in "${packages_extensions[@]}"; do
			packages_install+=("$(yq '.package' <<<"$extension")")
			mapfile -t extension_dconfs < <(yq -r '.dconf[]' <<<"$extension")

			for extension_dconf in "${extension_dconfs[@]}"; do
				dconf_configs+=("$extension_dconf")
			done
		done
	fi

	## Packages
	if [ -z "${packages_install[*]}" ] &&
		[ -z "${packages_remove[*]}" ] &&
		[ -z "${kmod_names[*]}" ] &&
		[ -z "${dconf[*]}" ]; then
		echo_error "No packages / config defined for $yml_file: '${repos[*]}'"
		exit 1
	fi

	# Pre install
	if [ ! "$pre_install_command" = "null" ]; then
		echo_color "Running pre install command for $yml_file: '${repos[*]}'"
		echo "$pre_install_command"
		eval "$pre_install_command"
	fi

	# Packages - replace
	if [ -n "${packages_remove[*]}" ] && [ -n "${packages_install[*]}" ]; then
		echo_color "Replacing packages for $yml_file: '${repos[*]}'"

		rpm-ostree override remove "${packages_remove[@]}" --install "${packages_install[@]}"
	else
		# Packages - remove
		if [ -n "${packages_remove[*]}" ]; then
			echo_color "Removing packages for $yml_file: '${repos[*]}'"
			rpm-ostree override remove "${packages_remove[@]}"
		fi

		# Packages - install
		if [ -n "${packages_install[*]}" ]; then
			echo_color "Installing packages for $yml_file: '${repos[*]}'"

			if [ "${repos[0]}" = "local" ]; then
				local_rpms=()
				for package_name in "${packages_install[@]}"; do
					file=$(find "$LOCAL_RPM_DIR" -type f -name "${package_name}*.rpm" -print -quit)
					if [ -z "$file" ]; then
						echo_error "Local package not found: $package_name"
					fi

					local_rpms+=("$file")
				done

				rpm-ostree install "${local_rpms[@]}"
			else
				rpm-ostree install "${packages_install[@]}"
			fi
		fi
	fi

	[ "$disable_repo" = "false" ] || disable_repos repo_files repos

	# Extension config
	if [ -n "${packages_extensions[*]}" ]; then
		enable_gnome_extensions packages_extensions
	fi

	# Dconf
	if [ -n "${dconf_configs[*]}" ]; then
		set_dconf dconf_configs
		dconf update
	fi

	# Post install
	if [ ! "$post_install_command" = "null" ]; then
		echo_color "Running post install command for $yml_file: '${repos[*]}'"
		echo "$post_install_command"
		eval "$post_install_command"
	fi

done

echo_color "Committing changes to container"
ostree container commit

echo_success "Successfully built: $yml_file"
