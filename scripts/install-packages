#!/bin/bash

set -e
set -o pipefail

yml_file=$1

source "${SCRIPTS_DIR}/deps/utils.sh"
source "${SCRIPTS_DIR}/deps/gnome-extensions.sh"

package_config="${PACKAGES_DIR}/${yml_file}"

if [ ! -f "$package_config" ]; then
	echo_error "Config file not found: $package_config"
	exit 1
fi

echo_color "\n==== Installing $yml_file ===="

readarray repos < <(yq -o=j -I=0 '.[]' "$package_config")
for repo_packages in "${repos[@]}"; do
	# repo is a single json snippet
	repo=$(echo "$repo_packages" | yq '.repo' -)
	repo_file=$(echo "$repo_packages" | yq '.repo_file' -)
	pre_install_command=$(echo "$repo_packages" | yq '.pre_install_command' -)
	post_install_command=$(echo "$repo_packages" | yq '.post_install_command' -)
	readarray -t packages_install < <(echo "$repo_packages" | yq '.install[]' | envsubst)
	readarray -t packages_remove < <(echo "$repo_packages" | yq '.remove[]' | envsubst)
	readarray -t packages_extensions < <(echo "$repo_packages" | yq '.extensions[]' | envsubst)
	readarray -t packages_kmods < <(echo "$repo_packages" | yq '.kmods[]' | envsubst)

	# Extensions
	if [ -n "${packages_extensions[*]}" ]; then
		echo_color "Installing extensions from '$repo'"

		for extension in "${packages_extensions[@]}"; do
			packages_install+=("$(echo "$extension" | yq '.package' -)")
		done
	fi

	## Packages
	if [ -z "${packages_install[*]}" ] &&
		[ -z "${packages_remove[*]}" ]; then
		echo_error "No packages defined for '$repo'"
		exit 1
	fi

	# Pre install
	if [ ! "$pre_install_command" = "null" ]; then
		echo_color "Running pre install command"
		echo "$pre_install_command"
		eval "$pre_install_command"
	fi

	# Packages - replace
	if [ -n "${packages_remove[*]}" ] && [ -n "${packages_install[*]}" ]; then
		if [ -n "${packages_install[*]}" ]; then
			echo_color "Replacing packages from '$repo'"

			if [ "$repo" = "fedora" ]; then
				rpm-ostree override remove "${packages_remove[@]}" --install "${packages_install[@]}"

			elif [ ! -f "${REPOS_DIR}/${repo_file}" ]; then
				enable_repo "$repo_file" "$repo"
				rpm-ostree override remove "${packages_remove[@]}" --install "${packages_install[@]}"
				disable_repo "$repo_file" "$repo"

			else
				enable_repo_extern "$repo_file" "$repo"
				rpm-ostree override remove "${packages_remove[@]}" --install "${packages_install[@]}"
				disable_repo_extern "$repo_file" "$repo"
			fi
		fi
	else
		# Packages - remove
		if [ -n "${packages_remove[*]}" ]; then
			echo_color "Removing packages for '$repo'"
			rpm-ostree override remove "${packages_remove[@]}"
		fi

		# Packages - install
		if [ -n "${packages_install[*]}" ]; then
			echo_color "Installing packages from '$repo'"

			if [ "$repo" = "fedora" ]; then
				rpm-ostree install "${packages_install[@]}"

			elif [ ! -f "${REPOS_DIR}/${repo_file}" ]; then
				enable_repo "$repo_file" "$repo"
				rpm-ostree install "${packages_install[@]}"
				disable_repo "$repo_file" "$repo"

			else
				enable_repo_extern "$repo_file" "$repo"
				rpm-ostree install "${packages_install[@]}"
				disable_repo_extern "$repo_file" "$repo"
			fi
		fi
	fi

	#Kmods
	if [ -n "${packages_kmods[*]}" ]; then
		echo_color "Installing kmods from '$repo'"

		kmod_packages_paths=()
		for name in "${packages_kmods[@]}"; do
			for rpm_package in "${KMODS_RPM_DIR}"/"${name}"/*.rpm; do
				kmod_packages_paths+=("$rpm_package")
			done
		done

		if [ -z "${kmod_packages_paths[*]}" ]; then
			echo_error "Failed to get kmod packages in ${KMODS_RPM_DIR}/${name}/"
			exit 1
		fi

		if [ "$repo" = "fedora" ]; then
			rpm-ostree install "${kmod_packages_paths[@]}"

		elif [ ! -f "${REPOS_DIR}/${repo_file}" ]; then
			enable_repo "$repo_file" "$repo"
			rpm-ostree install "${kmod_packages_paths[@]}"
			disable_repo "$repo_file" "$repo"

		else
			enable_repo_extern "$repo_file" "$repo"
			rpm-ostree install "${kmod_packages_paths[@]}"
			disable_repo_extern "$repo_file" "$repo"
		fi

	fi

	# Extension config
	if [ -n "${packages_extensions[*]}" ]; then enable_extensions packages_extensions; fi

	# Post install
	if [ ! "$post_install_command" = "null" ]; then
		echo_color "Running post install command"
		echo "$post_install_command"
		eval "$post_install_command"
	fi

done

echo_color "Commiting changes to container"
ostree container commit
