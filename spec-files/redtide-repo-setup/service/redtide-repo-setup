#!/bin/bash

set -e
set -o pipefail

# shellcheck disable=SC1091
[[ -f /etc/redtide-repo-setup.conf ]] && source /etc/redtide-repo-setup.conf
execute_in_dev="${REDTIDE_REPO_SETUP_RUN_IN_DEV:-0}"

send_notification_to_all_graphical_users() {
    local title="$1"
    local message="$2"
    local id user

    for id in $(loginctl list-sessions -j | jq -r '.[].session'); do
        if [[ $(loginctl show-session "$id" --property=Type --value) =~ (wayland|x11) ]]; then
            user=$(loginctl show-session "$id" --property=Name --value)

            systemd-run --machine="${user}@.host" --user \
                notify-send "$title" "$message" || true
        fi
    done
}

status_json=$(rpm-ostree status --json)
container_image_reference=$(echo "$status_json" | jq -r '.deployments[0]["container-image-reference"]')
image_tag="${container_image_reference##*:}"

if [[ "$container_image_reference" == *"redtide"* && "$image_tag" == "dev" && "$execute_in_dev" != "1" ]]; then
    echo "Nothing to do on dev image"
    exit 0
fi

# =====> Rebase to ostree commit signing if not already done

if [[ "$container_image_reference" == *"redtide"* && "$container_image_reference" != ostree-remote-registry:redtide:ghcr.io/pvermeer/redtide:* ]]; then

    if [[ "$image_tag" == "dev" ]]; then
        image_tag="testing-dev"
    fi

    echo "===> Rebase to ostree commit signing needed"
    echo
    echo "Current image reference: $container_image_reference"
    echo "Channel: $image_tag"
    echo

    if ! rpm-ostree rebase "ostree-remote-registry:redtide:ghcr.io/pvermeer/redtide:${image_tag}"; then
        echo "Rebase failed" >&2

        send_notification_to_all_graphical_users \
            "RedTide Update Failed" \
            "The RedTide image signing method has changed. Automatic migration failed. Please rebase manually using RedTide Setup."
    fi
fi
